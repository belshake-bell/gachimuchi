%    \begin{macrocode}
%% \gcmc@i@musline
%%   #1=key-val{hoffset[\qn@width], voffset, text, textpos}
%%   #2=musline id
%%   #3=start pitch[\internote]
\def\gcmc@i@musline[#1]#2#3{%
  \global\advance\N@musline\@ne % update musline counter
  \s@l@ctmusline#2\relax
  % test for already invoked \islur
  \if x\the\musline@s \else\errmessage{\@mis\noexpand\tmusline#2}\fi
  \setkeys[gcmc]{imusline}{#1}%
  \global\musline@Y\cmdgcmc@imusline@voffset% store start voffset
  \expandafter\global\expandafter\musline@s\expandafter
    {\cmdgcmc@imusline@textpos}%  store sense (u,d)
  \expandafter\global\expandafter\musline@t\expandafter
    {\cmdgcmc@imusline@text}%     store text
  \global\musline@N\noinstrum@nt% store instrument number
  \inhgetn@i#3\relax
  \global\musline@y\n@i %         start vpos (steps of internote)
  \global\musline@a\altportee %   store altportee of current slur
  \getcurpos
  \advance\y@v\cmdgcmc@imusline@hoffset\qn@width
  \global\musline@x\y@v %         start hpos
  \endgroup\fi%
}
%    \end{macrocode}
% \end{macro}
% \subparagraph{終点}
% \begin{macro}{\gcmc@tmusline@hoffset}
% コマンドキーを定義します．
%    \begin{macrocode}
\define@cmdkey[gcmc]{tmusline}{hoffset}[\z@]{}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\gcmc@tmusline@voffset}
% コマンドキーを定義します．
%    \begin{macrocode}
\define@cmdkey[gcmc]{tmusline}{voffset}[\z@]{}
%    \end{macrocode}
% \end{macro}
% 定義したコマンドキーをプリセットとします．
%    \begin{macrocode}
\presetkeys[gcmc]{tmusline}{hoffset,voffset}{}
%    \end{macrocode}
% \begin{macro}{\tmusline}\oarg{key-val}\marg{id}\marg{end pitch}\par
% muslineの終点を設定します．
% \begin{itemize}
% \item \meta{key-val}は様々なオプションを設定します．
%   \begin{itemize}
%   \item
%     \meta{hoffset}は現在のカーソルから右へずらす長さの係数を設定します．
%     単位は符頭の長さ\cmd{\qn@width}です．
%   \item
%     \meta{voffset}は始点の高さから上へずらす長さを設定します．
%   \end{itemize}
% \item \meta{id}は参照するmusline IDを設定します．
% \item \meta{end pitch}はmuslineの出力される終端部の高さを設定します．
% \end{itemize}
%    \begin{macrocode}
\def\tmusline{\@ifnextchar[%]
  {%
    \t@musline%
  }{%
    \t@musline[]%
  }%
}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\t@musline}\oarg{key-val}\marg{id}\marg{end pitch}\par
%    \begin{macrocode}
%% \t@musline #1=key-val #2=reference number #3=end note
\def\t@musline[#1]#2#3{%
  \check@staff
    \s@l@ctmusline#2\relax
%    \end{macrocode}
% \begin{itemize}
% \item
%   \cmd{\y@iv}: \meta{hoffset}.
% \item
%   \cmd{\@sense}: \cmd{\musline@s}.
% \item
%   \cmd{\y@v}: \meta{duration from x1 to x2}.
% \end{itemize}
%    \begin{macrocode}
    \setkeys[gcmc]{tmusline}{#1}%
    \y@iv\cmdgcmc@tmusline@hoffset
    \def\@sense{\the\musline@s}%
% test for missing \ibkt
    \if x\@sense \errmessage{\@mis\noexpand\imusline#2}\fi
% compute length
    \getcurpos
    \advance\y@v\y@iv
% eoline
    \y@eol\advance\y@-\beforeruleskip
% clip musline at eoline
    \ifdim\y@v>\y@ \y@v\y@ \advance\y@v\beforeruleskip \y@iv\beforeruleskip \fi
    \advance\y@v-\musline@x
    \inhgetn@i#3\relax
    \write@musline{\musline@y}{\n@i}{\y@v}{-\y@iv}%
% reset sense of musline
    \global\musline@s{x}\let\T@i\empty
    \global\advance\N@musline\m@ne% update slur counter
  \fi
}

%    \end{macrocode}
% \end{macro}
% \begin{macro}{\write@musline}
% muslineの描画部分です．
%    \begin{macrocode}
% #1 start pitch #2 end pitch #3 length #4 right hoffset
\def\write@musline#1#2#3#4{%
  \check@staff %
    \ifx\musline@N\undefined
      \relax %
    \else
      \edef\internote{\csname i@n\romannumeral\musline@N\endcsname}%
    \fi
    \n@iv#1%
    \n@vi#2%
    \y@iii#3%
%%
%%   Get note vertical offsets
%%   \n@iv=   vertical offset of first  note(n@i temp);
%%   \n@vi=   vertical offset of second note(n@ii temp);
%%   \y@i =   reference height of first note (pt);
%%   \y@ii=   reference height of end note (pt);
%%   \y@iii=  musline length (pt);
%%
    \n@i\n@vi \pl@base \y@ii\y@i \n@ii\n@vi% \y@ii = end height
    \n@i\n@iv \pl@base % \y@i = initial height
    \advance\y@i \musline@Y% add the voffsets
    \advance\y@ii\cmdgcmc@tmusline@voffset% add the voffsets
    \ifx\@Ti\@ne
      \advance\y@i\musline@a
      \advance\y@ii\musline@a
      \let\@Ti\empty
    \fi% call from cutslur
%%
%% draw musline
%%
    \llap{%
      \tikz[baseline=0.0ex]{%
        \draw[semithick]
          (0,\y@i)-- (\y@iii,\y@ii);
        \if u\the\musline@s
          \node at ($(\h@lf\y@iii,\y@ii)+(0,\internote)$)
          [above]
          {\the\musline@t};
        \else
          \if d\the\musline@s
            \node at ($(\h@lf\y@iii,\y@ii)-(0,\internote)$)
            [below]
            {\the\musline@t};
          \else
            \if l\the\musline@s
              \node at ($(\h@lf\y@iii,\y@ii)-(0,\internote)$)
              [below]
              {\the\musline@t};
            \else
              \PackageError{gcmcline}
                           {unexpacted sence \the\musline@s: u, d or l}%
            \fi
          \fi
        \fi
      }%
      \hspace{-\y@iv}%
    }%
  \fi
} % end writ@musline
\setmaxmuslines6

%    \end{macrocode}
